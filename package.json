{
  "name": "metersphere-control-panel",
  "version": "2.0.0",
  "description": "macOS 本地服务启动与关闭控制中心",
  "author": "MeterSphere Team",
  "main": "electron.js",
  "scripts": {
    "start": "node backend/server.js",
    "predev": "node scripts/clean-port.js 3000 5000 && node scripts/clean-port.js 3001 5000",
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run electron:dev\"",
    "dev:web": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "electron:dev": "ELECTRON_START_URL=http://localhost:3001 MS_ELECTRON_EXTERNAL_BACKEND=1 electron .",
    "build": "cd frontend && npm run build",
    "verify:desktop": "node --check electron.js && node --check backend/services/desktopAppService.js && node --check backend/services/desktopAppConfigService.js && node --check backend/services/backendShutdownService.js && npm run build",
    "electron:app": "npm run build && electron-builder --mac --dir",
    "electron:build": "npm run electron:app",
    "pack": "npm run electron:app",
    "dist": "npm run build && electron-builder --mac dmg",
    "install:local": "bash scripts/install-local-app.sh",
    "install:all": "npm install && cd frontend && npm install",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.2",
    "fix-path": "^3.0.0",
    "js-yaml": "^4.1.1",
    "mysql2": "^3.20.0",
    "redis": "^5.11.0",
    "rxjs": "^7.8.2",
    "uuid": "^9.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "build": {
    "appId": "com.localservicehub.desktop",
    "productName": "Local Service Hub",
    "artifactName": "Local-Service-Hub-${version}-${arch}.${ext}",
    "asar": false,
    "files": [
      "electron.js",
      "electron-preload.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!frontend/src",
      "!scripts",
      "!docs",
      "!**/*.md",
      "!.git*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Local Service Hub"
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
